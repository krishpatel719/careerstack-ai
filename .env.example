GROQ_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEMO_MODE=false
ENVIRONMENT=development
STORAGE_BACKEND=json
MONGODB_URI=
MONGODB_DATABASE=careerstack
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production persistence: MongoDB Atlas. Paste the Atlas "Connection string"
# from Database Access -> Add New Database User / Network Access. Keep this
# URI secret and never commit the populated .env file.
STORAGE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=careerstack

# JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch).
# Optional -- leave empty and the JSearch source is skipped; discovery still
# runs on Adzuna and Greenhouse.
#
# Having a RapidAPI key is NOT enough: you must also click "Subscribe to
# Test" on the JSearch API page and pick the free Basic plan (200 req/month).
# An unsubscribed key returns 403 "You are not subscribed to this API" --
# byte-identical to the response for a completely invalid key, so it reads
# like a bad key when it isn't.
#
# Consumption is tracked locally: python scripts/check_quota.py
RAPIDAPI_KEY=
